            "put": {
                "tags": [
                    "Tutors"
                ],
                "summary": "Set authenticated tutor availability",
                "description": "Replaces the authenticated tutor availability for a date. Hours must be whole-hour slots between 08:00 and 17:00.",
                "operationId": "8347f5ddf17cc9361c8abff80f57ec4c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "date",
                                    "hours"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Horario de clases de septiembre",
                                        "maxLength": 150
                                    },
                                    "date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-09-20"
                                    },
                                    "hours": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "pattern": "^([0-1][0-9]):00$",
                                            "example": "08:00"
                                        },
                                        "maxItems": 10,
                                        "minItems": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Tutor availability updated successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Authenticated user is not a tutor"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
