                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Logout successful"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/paypal/create-order": {
            "post": {
                "tags": [
                    "PayPal"
                ],
                "summary": "Create PayPal order",
                "description": "Validates the tutoring reservation data and creates a PayPal order without creating the reservation.",
                "operationId": "9c7799785dbb092dae0eded28ba0419b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "tutor_id",
                                    "date",
                                    "hours"
                                ],
                                "properties": {
                                    "tutor_id": {
                                        "type": "integer",
                                        "example": 26
                                    },
                                    "date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-08-18"
                                    },
                                    "hours": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "example": "10:00"
                                        },
                                        "example": [
                                            "10:00",
                                            "11:00",
                                            "12:00"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "PayPal order created successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
