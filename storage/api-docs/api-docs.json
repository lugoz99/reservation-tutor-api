        "/api/reservations/{id}": {
            "delete": {
                "tags": [
                    "Students"
                ],
                "summary": "Cancel an authenticated student reservation",
                "description": "Cancels a confirmed reservation at least 24 hours before its start time. No refund is issued.",
                "operationId": "556c78c34213ad52e7b4ab136aed8aa1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Reservation ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 15
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "cancellation_reason"
                                ],
                                "properties": {
                                    "cancellation_reason": {
                                        "type": "string",
                                        "example": "Tuve un imprevisto personal y no podré asistir.",
                                        "maxLength": 500,
                                        "minLength": 10
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reservation cancelled successfully"
                    },
                    "400": {
                        "description": "Business rule prevents cancellation"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Not authorized"
                    },
                    "404": {
                        "description": "Reservation not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
