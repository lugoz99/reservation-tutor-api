{
    "openapi": "3.0.0",
    "info": {
        "title": "Tutor Reservation API",
        "description": "RESTful API for tutor reservations",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Main server"
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Register a new student",
                "description": "Creates a new student account and returns a Sanctum access token.",
                "operationId": "8e4e3cb7b46126f4696379d3c7eeb4ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_names",
                                    "last_names",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "first_names": {
                                        "type": "string",
                                        "example": "Luis"
                                    },
                                    "last_names": {
                                        "type": "string",
                                        "example": "Gonzalez"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "luis@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login",
                "description": "Authenticates a user and returns a Sanctum access token.",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "luis@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User logged in successfully"
                    },
                    "422": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout",
                "description": "Revokes the current Sanctum access token.",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Logout successful"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/tutors": {
            "get": {
                "tags": [
                    "Tutors"
                ],
                "summary": "Get tutors",
                "operationId": "9bbbb366948632e3ea8de58ac09a149a",
                "responses": {
                    "200": {
                        "description": "Tutors retrieved successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/tutors/{id}": {
            "get": {
                "tags": [
                    "Tutors"
                ],
                "summary": "Get tutor by ID",
                "operationId": "0503cd6af448456d5f8e33650b1b1f7a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Tutor ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 26
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Tutor retrieved successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "404": {
                        "description": "Tutor not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/tutors/{id}/calendar": {
            "get": {
                "tags": [
                    "Tutors"
                ],
                "summary": "Get tutor calendar availability",
                "operationId": "020af2e05f6473e1b4ef9be3e844c650",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Tutor ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 26
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "description": "Date to check availability",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        },
                        "example": "2026-08-18"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Tutor calendar retrieved successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "404": {
                        "description": "Tutor not found"
                    },
                    "422": {
                        "description": "Invalid date"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/tutors/reservations": {
            "get": {
                "tags": [
                    "Tutors"
                ],
                "summary": "Get authenticated tutor reservations",
                "description": "Returns all reservations belonging to the authenticated tutor, including the student who made each reservation.",
                "operationId": "db974600d3a8fbf01d0c923ce0d6ef3c",
                "responses": {
                    "200": {
                        "description": "Tutor reservations retrieved successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Authenticated user is not a tutor"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/health": {
            "get": {
                "tags": [
                    "System"
                ],
                "summary": "Health check",
                "operationId": "233112e5605981fd8b8661ebc4b3a3f7",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Bearer token generated by Sanctum",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Tutors",
            "description": "Tutors"
        },
        {
            "name": "System",
            "description": "System"
        }
    ]
}