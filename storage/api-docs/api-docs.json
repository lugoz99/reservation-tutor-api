                "summary": "Get authenticated tutor calendar",
                "description": "Returns the availability calendar of the authenticated tutor.",
                "operationId": "a2285e7020ef68eed19b1d7a3dda9e80",
                "parameters": [
                    {
                        "name": "date",
                        "in": "query",
                        "description": "Date to check availability",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        },
                        "example": "2026-08-18"
